# Files excluded from Google Cloud uploads

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / OS
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.DS_Store

# git
.git
.gitignore
.gitattributes

# Env / secrets (never upload)
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Build
dist/
build/

# Tests
coverage/
.nyc_output/

# Docker / CI
docker-compose.yml
Dockerfile.dev
.dockerignore
.github/

# Docs (optional for runtime image builds via Dockerfile — keep out of gcloud source upload)
README*.md
CHANGELOG.md
docs/
CONTRIBUTING.md
*.md
!LICENSE

# Tooling
.prettierrc
.eslintrc
