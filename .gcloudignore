# .gcloudignore file for Google Cloud
# 指定哪些文件不應該上傳到 Google Cloud

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# git
.git
.gitignore
.gitattributes

# 環境變數
.env
.env.local
.env.*.local

# 日誌
logs/
*.log

# 構建產物
dist/
build/

# 測試
coverage/
.nyc_output/

# Prisma
prisma/migrations/

# Docker
docker-compose.yml
Dockerfile.dev
.dockerignore

# CI/CD
.github/
github/

# 開發文件
README*.md
CHANGELOG.md
docs/

# 證書
certificates/

# 其他
*.md
.prettierrc
.eslintrc
tsconfig.json
