# =============================================================================
# GCP migration config — copy to config.env (gitignored) and fill in.
#   cp config.env.example config.env
# Every script in this folder sources config.env.
# =============================================================================

# --- Source (old, organization-owned) project --------------------------------
SRC_PROJECT_ID=

# --- Destination (new, "No organization") project ----------------------------
# Must be created by a consumer Google account (gmail.com) or any account whose
# Workspace / Cloud Identity org does not force new projects into the org.
DST_PROJECT_ID=
DST_PROJECT_NAME="Kura"
# gcloud billing accounts list  → 0X0X0X-0X0X0X-0X0X0X
BILLING_ACCOUNT_ID=

# --- Region -------------------------------------------------------------------
# Cloud Run + Cloud SQL region in the new project (defaults to the source region).
REGION=us-central1

# --- Cloud SQL ----------------------------------------------------------------
# Source instance name (leave empty to auto-detect when the project has one).
SQL_INSTANCE=
# Destination instance name (defaults to SQL_INSTANCE).
DST_SQL_INSTANCE=
# Destination machine tier (defaults to the source tier).
DST_SQL_TIER=
# Database / app user. Must match the GitHub Variables DB_NAME / DB_USER.
DB_NAME=kura_db
DB_USER=postgres
# Password for DB_USER in the NEW instance. Reuse the existing GitHub Secret
# DB_PASSWORD so deploy.yml keeps working, or set a fresh one and update GitHub.
DB_PASSWORD=
# Password for the built-in `postgres` superuser (only used if DB_USER != postgres).
DB_ROOT_PASSWORD=

# --- Cloud Run ----------------------------------------------------------------
# Space-separated service names to migrate. Empty = every service in SRC project.
RUN_SERVICES=""

# --- Buckets (created if missing) --------------------------------------------
BACKUP_BUCKET=            # default: ${SRC_PROJECT_ID}-migration-backup
DST_BUCKET=               # default: ${DST_PROJECT_ID}-migration-backup

# --- Local backup location ---------------------------------------------------
# 10-backup.sh writes to ${BACKUP_ROOT}/<timestamp>; 20-rebuild.sh uses the
# newest folder unless BACKUP_DIR is set explicitly.
BACKUP_ROOT=./backups
BACKUP_DIR=
# Also `docker save` the images Cloud Run is currently running (insurance in
# case the old registry disappears before you rebuild). Needs docker.
SAVE_IMAGES=true

# --- GitHub Actions deploy identity in the NEW project -----------------------
DEPLOY_SA_NAME=github-deploy

# --- Custom domains (optional) -----------------------------------------------
# "domain=service" pairs, space-separated. Domain must be verified by the
# account running 20-rebuild.sh (gcloud domains list-user-verified).
# DOMAINS="api.kura-finance.com=kura-backend app.kura-finance.com=app"
DOMAINS=""

# --- GitHub repos for 40-github-config.sh ------------------------------------
GH_BACKEND_REPO=Kura-Finance/BackendServer
GH_WEB_REPO=Kura-Finance/WebClients
