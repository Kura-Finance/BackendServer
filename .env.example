# =============================================================================
# Kura Backend — environment example (functional only; no brand vars)
# =============================================================================
# cp .env.example .env.development
# Toggle domains: src/config/features.ts
# GitHub inventory: docs/SECRETS.md
# =============================================================================

NODE_ENV=development
PORT=8080

# --- Core (always) -----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
# 64 lowercase hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kura_db
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public

# CORS (production: only source of allowed origins; also used to derive app URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin allowlist (FEATURES.admin) — also used for fraud/ops mail when email on
# ADMIN_EMAIL=admin@example.com
# ADMIN_EMAILS=admin@example.com,ops@example.com

# --- Auth / Privy (login) ----------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# --- Auth / WebAuthn (passkeys) ----------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kura
WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_RELATED_ORIGINS=http://localhost:3000

# --- Mobile well-known (optional; 404 if unset) ------------------------------
# APPLE_APP_ID=
# ANDROID_PACKAGE_NAME=
# ANDROID_SHA256_CERT_FINGERPRINTS=

# --- FEATURES.email ----------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@example.com

# --- FEATURES.plaid ----------------------------------------------------------
# PLAID_CLIENT_ID=
# PLAID_SANDBOX_SECRET=
# PLAID_PRODUCTION_SECRET=
# PLAID_REDIRECT_URI=
# PLAID_WEBHOOK_URL=
# PLAID_SANDBOX_USER_IDS=

# --- FEATURES.stripe ---------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_ULTIMATE_MONTHLY=
# STRIPE_PRICE_ULTIMATE_YEARLY=

# --- FEATURES.debank ---------------------------------------------------------
# DEBANK_ACCESS_KEY=

# --- FEATURES.bridge ---------------------------------------------------------
# BRIDGE_API_KEY=
# BRIDGE_WEBHOOK_PUBLIC_KEY=
# BRIDGE_WALLET_ID=

# --- FEATURES.dinari ---------------------------------------------------------
