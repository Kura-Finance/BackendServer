# =============================================================================
# Kura Backend — environment example
# =============================================================================
# Copy to a local file (do not commit real secrets):
#   cp .env.example .env.development
#
# Local boot loads `.env.${NODE_ENV}` when NODE_ENV != production and DB_HOST
# is unset (see src/config/env.ts). Default NODE_ENV is development.
#
# Full catalog: docs/ENVIRONMENT.md
# Proprietary vs free-public keys: docs/API_KEYS.md
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8080
# LOG_LEVEL=info
# DEBUG_COOKIES=false

# --- Feature flags -----------------------------------------------------------
# Edit src/config/features.ts (FEATURES map) — not env.
# Public snapshot: GET /api/features  (also in GET /health)

# --- Core secrets (required to start) ----------------------------------------
# Generate ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Database ----------------------------------------------------------------
# DATABASE_URL is built at startup from these vars (do not set it manually).
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kura_db
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public

# --- App / CORS / branding ---------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_NAME=Kura
APP_URL=http://localhost:3000
# APP_UPGRADE_URL=https://example.com/pricing
# ADMIN_EMAIL=admin@example.com
# ADMIN_EMAILS=admin@example.com,ops@example.com
# SUPPORT_EMAIL=support@example.com
# DEMO_USER_EMAILS=demo@example.com

# --- Email (Resend) — required in production ---------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# --- Auth: Privy (login) -----------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PEM or base64 verification key from Privy dashboard
PRIVY_VERIFICATION_KEY=

# --- Auth: WebAuthn / Passkeys -----------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kura
# Comma-separated; may include android:apk-key-hash:...
WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_RELATED_ORIGINS=http://localhost:3000

# --- Plaid — required in production ------------------------------------------
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=
# PLAID_ENV=sandbox
# PLAID_REDIRECT_URI=http://localhost:3000/plaid/oauth
# PLAID_WEBHOOK_URL=https://your-api.example.com/api/plaid/webhook
# PLAID_SANDBOX_USER_IDS=
# PLAID_COUNTRY_CODES=US

# --- Stripe — required in production -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_ULTIMATE_MONTHLY=
# STRIPE_PRICE_ULTIMATE_YEARLY=
# Legacy aliases (optional):
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ULTIMATE=

# --- DeBank — required in production -----------------------------------------
DEBANK_ACCESS_KEY=
# DEBANK_BASE_URL=https://pro-openapi.debank.com/v1
# DEBANK_CACHE_TTL_SECONDS=300

# --- Bridge (fiat on/off-ramp) — required in production -----------------------
BRIDGE_API_KEY=
# PEM public key; use \n for newlines in single-line secret stores
BRIDGE_WEBHOOK_PUBLIC_KEY=
# BRIDGE_API_URL=https://api.bridge.xyz/v0
# BRIDGE_FEE_CONFIG_ENABLED=false
# BRIDGE_WALLET_ID=
# BRIDGE_WALLET_CURRENCY=usdb
# BRIDGE_CUSTOMER_NAMED_PAYOUT=true
# BRIDGE_FUNDS_REQUESTS_SYNC_MIN_INTERVAL_MS=300000
# BRIDGE_DEPOSITS_SYNC_MIN_INTERVAL_MS=
# BRIDGE_DEPOSITS_PENDING_SYNC_MIN_INTERVAL_MS=

# --- Dinari (tokenized stocks) — required in production ----------------------
DINARI_API_KEY_ID=
DINARI_API_SECRET_KEY=
DINARI_ENVIRONMENT=sandbox
# DINARI_CHAIN_ID=eip155:8453
# DINARI_PAYMENT_TOKEN_ADDRESS=0x...
# DINARI_WHITELIST_EMAILS=you@example.com
# DINARI_WHITELIST_DOMAINS=example.com

# --- LI.FI analytics (optional key; integrator name needed for sync) ---------
LIFI_INTEGRATOR=kura
# LIFI_API_KEY=
# LIFI_TRANSFERS_MIN_INTERVAL_MS=

# --- Logos (optional; free Google favicons / jsDelivr when unset) ------------
# LOGO_DEV_TOKEN=

# --- Mobile associated domains (well-known) — optional -----------------------
# APPLE_APP_ID=
# ANDROID_PACKAGE_NAME=
# ANDROID_SHA256_CERT_FINGERPRINTS=

# --- Misc optional -----------------------------------------------------------
# REFERRAL_CASHBACK_RATE=
# REFERRAL_CASHBACK_HOLD_DAYS=
# PRIVY_METRICS_MIN_INTERVAL_MS=
# PLATFORM_BACKFILL_MIN_INTERVAL_MS=
