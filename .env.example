# DINARI_API_SECRET_KEY=
# DINARI_ENVIRONMENT=sandbox
# DINARI_CHAIN_ID=eip155:8453
# DINARI_PAYMENT_TOKEN_ADDRESS=
# DINARI_WHITELIST_EMAILS=
# DINARI_WHITELIST_DOMAINS=

# --- FEATURES.lifiAnalytics --------------------------------------------------
