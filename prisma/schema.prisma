// ==========================================
// 核心設定 (Configuration)
// ==========================================
generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider            = "prisma-dbml-generator"
  output              = "./dbml"
  outputName          = "schema.dbml"
  projectName         = "BackendServer"
  projectDatabaseType = "PostgreSQL"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. 核心用戶系統 (User & Auth)
// ==========================================
model User {
  id               String    @id @default(uuid())
  // email 由 Privy 提供；無 linked email 時以 {userId}@placeholder.kura-finance.internal 佔位
  email            String    @unique
  stripeCustomerId String?   @unique
  referCode        String    @unique
  referredByUserId String?
  referredAt       DateTime?

  // ── Privy 認證（取代 SRP）─────────────────────────────────
  // privyUserId：Privy DID（did:privy:...），登入身分的主鍵
  // walletAddress：Privy embedded wallet EOA 地址（簽名/登入綁定）
  // scaAddress：ERC-4337 Smart Contract Account 地址（付款結算用）
  privyUserId   String? @unique
  walletAddress String?
  scaAddress    String?

  // ── E2EE KEK 推導 salt（改由 Passkey PRF 使用）──────────────
  // 原本是 SRP/password 派生 KEK 的 salt，現在前端用 Passkey PRF + 此 salt
  // 推導 KEK 來 wrap encryptedPrivateKey。後端僅儲存，永不參與推導。
  kekSalt String?

  // ── E2EE Key Pair (Phase 3 - Zero Access Encryption) ──────
  // 用戶端生成 X25519 keypair：
  //   publicKey 由後端用來 wrap 每次 sync 的 SEK
  //   encryptedPrivateKey 用 KEK 加密後存放，後端永遠無法解
  publicKey           String? // base64(X25519 pubkey, 32 bytes)
  encryptedPrivateKey String? // base64(nonce | XChaCha20-Poly1305(privKey, KEK))
  keyPairAlgorithm    String    @default("x25519-xchacha20")
  keyPairCreatedAt    DateTime?

  name            String?
  avatarUrl       String?
  tier            String   @default("Basic")
  cashbackBalance Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 關聯：Dashboard 模組 (金融帳戶)
  plaidItems                  PlaidItem[]
  exchangeAccounts            ExchangeAccount[]
  exchangeCaches              ExchangeCache[]

  // 關聯：Plaid 快取模組 (減少 API 調用)
  plaidAccountCache           PlaidAccountCache[]
  plaidTransactionCache       PlaidTransactionCache[]
  plaidInvestmentAccountCache PlaidInvestmentAccountCache[]
  plaidInvestmentCache        PlaidInvestmentCache[]
  plaidSyncLog                PlaidSyncLog?

  // 關聯：API 操作限制 (限制用戶 API 調用頻率)
  apiOperationLogs ApiOperationLog[]

  // 關聯：Asset Performance 模組 (per-metric encrypted snapshots)
  assetSnapshots AssetSnapshot[]

  // 關聯：通知系統 (Notification System)
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  debankCaches            DeBankCache[]
  stripeSubscriptions     StripeSubscription[]
  inviterCashbacks        ReferralCashback[]       @relation("ReferralCashbackInviter")
  referredCashbacks       ReferralCashback[]       @relation("ReferralCashbackReferred")

  referredBy    User?  @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers User[] @relation("UserReferrals")

  // 關聯：E2EE 加密 payload key（每個用戶可能有多個 wrappedSek）
  encryptedPayloadKeys EncryptedPayloadKey[]

  // 關聯：Passkey / WebAuthn（E2EE 資料層解鎖）
  passkeyCredentials PasskeyCredential[]
  webauthnChallenge  WebAuthnChallenge?

  // 關聯：Bridge On/Off Ramp（法幣 <-> 穩定幣）
  bridgeCustomer         BridgeCustomer?
  bridgeTransfers        BridgeTransfer[]
  bridgeExternalAccounts BridgeExternalAccount[]
  bridgeVirtualAccounts  BridgeVirtualAccount[]
  bridgeVaEvents         BridgeVirtualAccountEvent[]
  bridgeLiquidationAddresses BridgeLiquidationAddress[]

  // 關聯：Dinari Tokenized Stocks（dShares）
  dinariEntity   DinariEntity?
  dinariAccounts DinariAccount[]
  dinariOrders   DinariOrder[]

  // 關聯：平台投資人報表
  platformRecords PlatformRecord[]

  @@index([referredByUserId])
  @@index([scaAddress])
}

// ==========================================
// 5. Passkey / WebAuthn（E2EE 資料層解鎖）
// ==========================================

// 已註冊的 WebAuthn 憑證（每個裝置一筆）。
// encryptedDek：用該 passkey（PRF 推導金鑰）包裝的 32-byte DEK（hex）；
//   passkey assertion 驗證成功後回傳給前端解開資料層。
model PasskeyCredential {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique // base64url credential id
  publicKey    String            // base64 COSE public key
  counter      Int      @default(0)
  transports   String[]          // ['internal','hybrid','usb','nfc','ble']
  deviceType   String?           // 'singleDevice' | 'multiDevice'
  backedUp     Boolean  @default(false)
  encryptedDek String?           // hex(32 bytes)：passkey 包裝的 DEK
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 進行中的 WebAuthn challenge（每個使用者同時只有一個，含過期時間）。
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    String   @unique
  challenge String            // base64url challenge
  type      String            // 'registration' | 'authentication'
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ==========================================
// 1.5 E2EE Payload Key (Zero Access Encryption)
// ==========================================
// 每次同步流程在後端生成一個 Session Encryption Key (SEK)，
// 用該用戶的 publicKey 做 sealed box 包裝後存入此表。
// 同一次 sync 內所有 row 共用同一個 wrappedSek。
// 後端寫完即丟棄 SEK，永遠無法解開 wrappedSek。
//
// 子表以 payloadKeyId 指向此表（DB 有 FK）；刻意不在此掛反向 relation，ERD 較乾淨。
model EncryptedPayloadKey {
  id         String   @id @default(uuid())
  userId     String
  // scope 範例：
  //   plaid_tx:{plaidItemId}        - Plaid 交易批次
  //   plaid_acct:{plaidItemId}      - Plaid 銀行帳戶批次
  //   plaid_inv:{plaidItemId}       - Plaid 投資批次
  //   exchange_balance:{accountId}  - 交易所餘額
  //   exchange_asset:{accountId}    - 交易所資產
  //   debank_token:{address}        - DeBank token
  //   debank_protocol:{address}     - DeBank protocol
  //   asset_snapshot:{metric}       - 資產快照（per-metric）
  scope      String
  wrappedSek String // base64(crypto_box_seal(SEK, userPublicKey))
  algorithm  String   @default("x25519-sealedbox+aes-256-gcm")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, createdAt])
}

// ==========================================
// 2. Dashboard 模組 (Banking & Crypto Exchange)
// ==========================================

// 傳統金融綁定 (Plaid 授權紀錄)
model PlaidItem {
  id                 String   @id @default(uuid())
  userId             String
  accessToken        String   @unique // Plaid API 的永久存取權杖
  itemId             String   @unique // Plaid 的銀行項目 ID
  transactionsCursor String? // transactions/sync cursor（每個 Plaid item 獨立維護）
  institutionName    String // 銀行或券商名稱 (例如: Chase, Robinhood)
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 斷線時連帶清除底下所有快取（onDelete: Cascade 由各 cache 的 plaidItem relation 設定）
  accountCaches           PlaidAccountCache[]
  transactionCaches       PlaidTransactionCache[]
  investmentAccountCaches PlaidInvestmentAccountCache[]
  investmentCaches        PlaidInvestmentCache[]
}

// ==========================================
// 2.5 加密貨幣交易所 (Exchange via CCXT)
// ==========================================

// 交易所帳戶綁定 (使用者連結的交易所 API 金鑰)
model ExchangeAccount {
  id                  String  @id @default(uuid())
  userId              String
  exchange            String // 交易所名稱 (例如: "binance", "kraken", "coinbase")
  exchangeDisplayName String // 交易所顯示名稱 (例如: "Binance", "Kraken", "Coinbase")
  apiKey              String // 加密存儲的 API Key (需加密)
  apiSecret           String // 加密存儲的 API Secret (需加密)
  passphrase          String? // 某些交易所需要的密語 (如 OKX)
  isActive            Boolean @default(true)

  // 驗證狀態
  isVerified        Boolean   @default(false) // 是否已驗證連接有效
  lastVerifiedAt    DateTime? // 上次驗證時間
  verificationError String? // 驗證失敗的錯誤信息

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  caches ExchangeCache[]

  @@unique([userId, exchange])
  @@index([userId])
}

// 交易所 E2EE 快取（balance | asset）
model ExchangeCache {
  id                String @id @default(uuid())
  userId            String
  exchangeAccountId String
  exchange          String
  kind              String // balance | asset
  symbol            String

  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, exchangeAccountId, kind, symbol])
  @@index([userId])
  @@index([userId, exchangeAccountId])
  @@index([userId, exchangeAccountId, kind])
  @@index([payloadKeyId])
}

// ==========================================
// 3. Asset Performance 模組 (資產績效追蹤)
// ==========================================

// 資產快照（Phase 3 Zero-Access E2EE only）。
//
// 每筆 row 只記一個 metric（per-metric snapshot）；同一 metric 同一天可有多筆 row，
// 前端讀取後按 sub-scoped key 取 latest、按 base 加總組合日線。
//
// metric 命名規則：
//   base：     "cashFlow" / "plaidInvestment"
//   sub-scoped："cryptoSpot:exchange:{accountId}"、"cryptoSpot:debank:{address}"、
//              "defiProtocol:debank:{address}"
model AssetSnapshot {
  id                String   @id @default(uuid())
  userId            String
  metric            String   // base 或 sub-scoped metric 名稱
  payloadCiphertext String   // base64(iv | tag | AES-256-GCM(SEK, JSON{value: number}))
  payloadKeyId      String   // wrappedSek 指針

  recordedAt DateTime // 記錄時間
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([userId, metric, recordedAt])
  @@index([payloadKeyId])
}

// ==========================================
// 4. Plaid 快取模組 (減少 API 調用，降低成本)
// ==========================================

// Plaid 帳戶快取（Phase 3 Zero-Access E2EE only）。
//
// 後端只持有 metadata（plaidItemId / accountId / type / bucket）+ payloadCiphertext + payloadKeyId。
// 敏感欄位（name / balance / institutionName / logo / plaidLogo / apy / mask）全部整包進 payloadCiphertext。
model PlaidAccountCache {
  id          String  @id @default(uuid())
  userId      String
  plaidItemId String? // 所屬的 Plaid Item（斷線時連帶 cascade 清除）
  accountId   String // Plaid 的帳戶 ID
  type        String // 帳戶類型 (checking, saving, credit, investment) — AssetService 算負債用
  bucket      String // 帳戶分類 (banking, investment) — AssetService 分組用

  // ── Phase 3 E2EE payload ──
  payloadCiphertext String? // base64(iv | tag | AES-256-GCM(SEK, JSON{name,balance,institutionName,logo,plaidLogo,apy,mask}))
  payloadKeyId      String?

  cachedAt  DateTime @default(now()) // 快取時間
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([payloadKeyId])
}

// Plaid 交易快取（Phase 3 Zero-Access E2EE only）。
//
// 後端只持有 metadata（accountId / transactionId / plaidItemId / date / month / isPending /
// isRecurring / isSubscription / lastWebhookUpdate）+ payloadCiphertext + payloadKeyId。
// 敏感欄位（amount, merchant, category, type, personalFinanceCategory, recurringFrequency,
// enrichedMerchantName, merchantLogo, merchantCategory, accountName, accountType）
// 全部整包進 payloadCiphertext。
model PlaidTransactionCache {
  id     String @id @default(uuid())
  userId String

  // ── metadata (plaintext) ──
  accountId         String // 所屬帳戶 ID
  transactionId     String // Plaid 交易 ID (dedup key)
  plaidItemId       String? // 所屬 Plaid Item
  date              String // 交易日期 (YYYY-MM-DD)
  month             String // 快取月份 (YYYY-MM)
  isPending         Boolean   @default(false)
  isRecurring       Boolean   @default(false)
  isSubscription    Boolean   @default(false)
  lastWebhookUpdate DateTime?

  // ── Phase 3 E2EE payload ──
  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, transactionId])
  @@index([userId])
  @@index([userId, month])
  @@index([userId, accountId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([userId, isRecurring])
  @@index([userId, isSubscription])
  @@index([payloadKeyId])
}

// Plaid 投資帳戶快取（Phase 3 Zero-Access E2EE only）。
// 後端只持有 metadata（accountId）+ payloadCiphertext + payloadKeyId。
// 敏感欄位（name, institutionName, logo, plaidLogo）整包進 payloadCiphertext。
model PlaidInvestmentAccountCache {
  id          String  @id @default(uuid())
  userId      String
  plaidItemId String? // 所屬的 Plaid Item（斷線時連帶 cascade 清除）
  accountId   String // Plaid 投資帳戶 ID

  // ── Phase 3 E2EE payload ──
  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([payloadKeyId])
}

// Plaid 投資持倉快取（Phase 3 Zero-Access E2EE only）。
// 後端只持有 metadata（accountId / investmentId / type）+ payloadCiphertext + payloadKeyId。
// 敏感欄位（symbol, name, holdings, currentPrice, change24h, logo）整包進 payloadCiphertext。
model PlaidInvestmentCache {
  id           String  @id @default(uuid())
  userId       String
  plaidItemId  String? // 所屬的 Plaid Item（斷線時連帶 cascade 清除）
  accountId    String // 所屬投資帳戶 ID
  investmentId String // 投資 ID (accountId-securityId)
  type         String // 資產類型 (stock, crypto, etf...) — 分組統計用

  // ── Phase 3 E2EE payload (內含 symbol, name, holdings, currentPrice, change24h, logo) ──
  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, investmentId])
  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([payloadKeyId])
}

// Plaid 同步狀態 (跟踪每個用戶的最後同步時間，避免過於頻繁的 API 調用)
model PlaidSyncLog {
  id     String @id @default(uuid())
  userId String @unique

  // 同步狀態
  lastSyncedAt         DateTime? // 上次完整同步時間
  accountsSyncedAt     DateTime? // 上次同步帳戶資料
  transactionsSyncedAt DateTime? // 上次同步交易資料 (按月份追蹤)
  investmentsSyncedAt  DateTime? // 上次同步投資資料

  // 同步統計
  totalAccounts     Int @default(0)
  totalTransactions Int @default(0)
  totalInvestments  Int @default(0)

  // 同步間隔設定 (秒)
  accountsCacheTtl     Int @default(3600) // 帳戶資訊 1 小時更新一次
  transactionsCacheTtl Int @default(1800) // 交易資訊 30 分鐘更新一次
  investmentsCacheTtl  Int @default(3600) // 投資資訊 1 小時更新一次

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// DeBank E2EE 快取（protocol | token）
model DeBankCache {
  id      String @id @default(uuid())
  userId  String
  kind    String // protocol | token
  address String
  chain   String
  entityId String // protocolId 或 tokenId

  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, address, chain, entityId])
  @@index([userId])
  @@index([userId, address])
  @@index([cachedAt])
  @@index([payloadKeyId])
}

// API 操作限制日誌 (追蹤用戶每日的 API 操作次數，支持多種操作類型)
model ApiOperationLog {
  id            String @id @default(uuid())
  userId        String
  operationType String // 操作類型: 'exchange_connect', 'exchange_balance', 'plaid_refresh'
  date          String // YYYY-MM-DD 格式，用於按日期查詢
  count         Int    @default(0) // 該天的操作次數

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationType, date]) // 每個用戶每天每種操作類型只有一條記錄
  @@index([userId])
  @@index([date])
  @@index([operationType])
}

// ==========================================
// 6. 通知系統 (Notification System)
// ==========================================

// 通知記錄表
model Notification {
  id            String    @id @default(uuid())
  userId        String // 接收通知的用戶
  type          String // 通知類型: 'email', 'push', 'in_app'
  category      String // 通知分類: 'price_alert', 'account_activity', 'transaction', 'system_alert', 'security'
  subject       String? // 通知主題 (郵件用)
  title         String // 通知標題
  message       String // 通知內容
  data          Json? // 額外數據
  actionUrl     String? // 動作URL (點擊通知跳轉)
  priority      String    @default("normal") // 優先級: 'low', 'normal', 'high'
  status        String    @default("pending") // 狀態: 'pending', 'sent', 'delivered', 'read', 'failed'
  failureReason String? // 失敗原因
  sentAt        DateTime? // 發送時間
  deliveredAt   DateTime? // 送達時間
  readAt        DateTime? // 閱讀時間
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

// 通知preferences表
model NotificationPreferences {
  id                       String   @id @default(uuid())
  userId                   String   @unique // 一個用戶一條記錄
  enableEmailNotifications Boolean  @default(true) // 啟用郵件通知
  enablePushNotifications  Boolean  @default(true) // 啟用推播通知
  enableInAppNotifications Boolean  @default(true) // 啟用應用內通知
  priceAlertThreshold      Float    @default(5) // 價格變化提醒閾值 (%)
  accountActivityAlerts    Boolean  @default(true) // 帳戶活動提醒
  transactionAlerts        Boolean  @default(true) // 交易提醒
  systemAlerts             Boolean  @default(true) // 系統通知
  securityAlerts           Boolean  @default(true) // 安全警告
  unsubscribeAll           Boolean  @default(false) // 取消訂閱所有通知
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6.5 Waitlist（公開 landing page 表單）
// ==========================================

model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String
  product   String   @default("default") // e.g. kura-app | dinari | card
  name      String?
  source    String? // landing | app_store | referral ...
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, product])
  @@index([createdAt])
  @@index([source])
  @@index([product])
}

// ==========================================
// 8. Billing 訂閱系統 (Stripe)
// ==========================================
model StripeSubscription {
  id                   String    @id @default(uuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  stripePriceId        String?
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([stripeCustomerId])
}

model StripeWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  payload       Json?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([type])
}

model ReferralCashback {
  id                   String    @id @default(uuid())
  inviterUserId        String
  referredUserId       String
  source               String    @default("stripe") // stripe | bridge_va | dinari | ...
  idempotencyKey       String    @unique
  externalId           String?
  eventType            String?
  stripeInvoiceId      String?   @unique
  stripeChargeId       String?
  stripeSubscriptionId String?
  grossAmount          Float
  cashbackAmount       Float
  currency             String    @default("usd")
  status               String    @default("pending") // pending | available | reversed
  availableAt          DateTime
  settledAt            DateTime?
  reversedAt           DateTime?
  reverseReason        String?
  reversedByEventId    String?
  createdAt            DateTime  @default(now())

  inviter  User @relation("ReferralCashbackInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralCashbackReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([inviterUserId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([status, availableAt])
  @@index([stripeChargeId])
  @@index([source, createdAt])
}

// ==========================================
// 9. Bridge On/Off Ramp (法幣 <-> 穩定幣)
// ==========================================
// Bridge (api.bridge.xyz) 提供 fiat <-> stablecoin 的 on/off ramp。
// 流程：先建立 Bridge customer（透過 hosted KYC link 完成 KYC + TOS），
// KYC 通過並取得相應 endorsement 後，才能建立 transfer 進行出入金。

// Bridge 客戶（每個用戶一個 Bridge customer，紀錄 KYC / endorsement 狀態）
model BridgeCustomer {
  id               String  @id @default(uuid())
  userId           String  @unique
  bridgeCustomerId String? @unique // Bridge customer ID（cust_...）
  kycLinkId        String? @unique // Bridge kyc_link ID

  customerType String  @default("individual") // individual | business
  email        String?
  // 註：刻意不存 fullName / rawCustomer。兩者皆含 PII（法定姓名、KYC 完整 payload），
  // 後端只需 fullName 即時轉送給 Bridge /kyc_links，無需落地；狀態由 kycStatus / endorsements 表達。

  kycLink   String? // hosted KYC 連結
  tosLink   String? // hosted TOS 連結
  kycStatus String  @default("not_started")
  // not_started | incomplete | awaiting_questionnaire | awaiting_ubo | under_review | approved | rejected | paused | offboarded
  // 註：awaiting_questionnaire / awaiting_ubo 為 KYB（business）流程特有
  tosStatus String  @default("pending") // pending | approved

  endorsements Json? // Bridge 回傳的 endorsements 陣列（base / sepa / spei ...）
  // Bridge rejection_reasons 完整 payload（含 developer_reason）；API 僅回傳客戶可看的 reason
  rejectionReasons Json?
  customerNamedPayoutAt DateTime? // 已向 Bridge 設定 customer-named fiat payout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalAccounts     BridgeExternalAccount[]
  transfers            BridgeTransfer[]
  virtualAccounts      BridgeVirtualAccount[]
  liquidationAddresses BridgeLiquidationAddress[]

  @@index([kycStatus])
}

// Bridge 外部銀行帳戶（off-ramp 法幣出金的目的地）
model BridgeExternalAccount {
  id                      String  @id @default(uuid())
  userId                  String
  bridgeExternalAccountId String  @unique // Bridge external_account ID
  bridgeCustomerId        String? // 所屬 Bridge customer（cust_...）
  bankName                String?
  accountOwnerName        String?
  last4                   String?
  currency                String  @default("usd")
  active                  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer               BridgeCustomer?              @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)
  payoutLiquidationAddresses BridgeLiquidationAddress[]

  @@index([userId])
  @@index([bridgeCustomerId])
}

// Bridge 轉帳（on-ramp / off-ramp / crypto-to-crypto）
model BridgeTransfer {
  id               String  @id @default(uuid())
  userId           String
  bridgeCustomerId String? // 所屬 Bridge customer（cust_...）
  bridgeTransferId String  @unique // Bridge transfer ID

  direction String // onramp | offramp | crypto
  state     String @default("awaiting_funds")
  // awaiting_funds | in_review | funds_received | payment_submitted | payment_processed | returned | refunded | canceled | error

  amount       String? // 金額（decimal string，例如 "100.25"）
  developerFee String? // 開發者抽成（decimal string）

  // ── source（資金來源）──
  sourceRail     String? // ach_push | wire | sepa | spei | ethereum | base | polygon | solana | arbitrum ...
  sourceCurrency String? // usd | eur | mxn | usdc | usdb | eurc ...

  // ── destination（資金去向）──
  destinationRail        String?
  destinationCurrency    String?
  destinationAddress     String? // on-ramp 的 crypto to_address
  destinationExternalId  String? // off-ramp 的 external_account ID
  destinationTxHash      String?

  // Bridge 回傳給用戶用來打款的指示（fiat 銀行資訊或 crypto 存款地址）
  depositInstructions Json?

  clientReferenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer BridgeCustomer?  @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, direction])
  @@index([state])
  @@index([bridgeTransferId])
  @@index([bridgeCustomerId])
}

// Bridge Virtual Account（每用戶專屬、持久的法幣入金帳戶；on-ramp 主要入金方式）
// 入金到此帳戶會自動轉成穩定幣並送到 destination，且不需每次帶 memo。
model BridgeVirtualAccount {
  id                     String  @id @default(uuid())
  userId                 String
  bridgeCustomerId       String? // 所屬 Bridge customer（cust_...）
  bridgeVirtualAccountId String  @unique // Bridge virtual account ID

  status String @default("activated") // activated | deactivated

  // ── source（法幣入金幣別）──
  sourceCurrency String // usd | eur | mxn ...

  // ── destination（自動轉換後送往的 crypto 目的地）──
  destinationRail     String // ethereum | base | polygon | solana ...
  destinationCurrency String // usdc | usdb ...
  destinationAddress  String

  developerFeePercent String? // 開發者抽成百分比（base 100，例如 "1.0" = 1%）

  // Bridge 回傳的銀行入金資訊（持久，直接回給前端顯示）
  depositInstructions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer BridgeCustomer?             @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)
  events   BridgeVirtualAccountEvent[]

  // 每個用戶針對同一組（入金幣別 + 目的鏈 + 目的幣別）只開一個 VA
  @@unique([userId, sourceCurrency, destinationRail, destinationCurrency])
  @@index([userId])
  @@index([bridgeVirtualAccountId])
  @@index([bridgeCustomerId])
}

// Virtual Account 活動帳本（入金 / 出款事件，來自 webhook 與 history）
model BridgeVirtualAccountEvent {
  id                     String @id @default(uuid())
  userId                 String
  bridgeVirtualAccountId String // 所屬 Bridge virtual account
  bridgeEventId          String @unique // VA event id（去重）

  type String // funds_received | payment_submitted | payment_processed | refunded | in_review | ...

  amount             String?
  currency           String?
  subtotalAmount     String?
  developerFeeAmount String?
  exchangeFeeAmount  String?
  gasFee             String?
  depositId          String? // 同一筆存款的關聯 id（多個事件共用）
  destinationTxHash  String?
  source             Json? // Bridge event source（付款人、payment rail 等）

  occurredAt DateTime?
  createdAt  DateTime @default(now())

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  virtualAccount BridgeVirtualAccount @relation(fields: [bridgeVirtualAccountId], references: [bridgeVirtualAccountId], onDelete: Cascade)

  @@index([userId])
  @@index([bridgeVirtualAccountId])
  @@index([depositId])
}

// Bridge Liquidation Address（永久 crypto 入金/出金地址）
// direction=in：Tron USDT → Base USDC 等 crypto 入金
// direction=out：Base USDC → 法幣銀行出金
model BridgeLiquidationAddress {
  id                         String  @id @default(uuid())
  userId                     String
  bridgeCustomerId           String?
  bridgeLiquidationAddressId String  @unique // Bridge liquidation address ID (la_...)

  direction String // in | out
  state     String @default("active") // active | deactivated

  // ── source（crypto 入金/出金來源）──
  sourceChain    String // tron | base ...
  sourceCurrency String // usdt | usdc ...

  // ── destination（自動兌換後送往的目的地）──
  destinationRail             String // base | wire | pix ...
  destinationCurrency           String // usdc | usd | brl ...
  destinationAddress            String? // in：使用者 crypto 收款地址
  bridgeExternalAccountId       String? // out：Bridge external_account ID
  returnAddress                 String? // out：失敗退款用的 crypto 地址

  depositAddress  String  // Bridge 提供的永久收款地址
  blockchainMemo  String? // Tron 等鏈必填 memo

  developerFeePercent String? // custom_developer_fee_percent（base 100）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer        BridgeCustomer?        @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)
  externalAccount BridgeExternalAccount? @relation(fields: [bridgeExternalAccountId], references: [bridgeExternalAccountId], onDelete: SetNull)

  @@unique([userId, direction, sourceChain, sourceCurrency, destinationRail, destinationCurrency, bridgeExternalAccountId])
  @@index([userId])
  @@index([userId, direction])
  @@index([bridgeLiquidationAddressId])
  @@index([bridgeCustomerId])
  @@index([bridgeExternalAccountId])
}

// Bridge webhook 事件去重（event_id 為全域唯一）
model BridgeWebhookEvent {
  id            String   @id @default(uuid())
  bridgeEventId String   @unique // Bridge event_id
  eventCategory String
  eventType     String
  payload       Json?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([eventType])
}

// ============================================================
// Dinari Tokenized Stocks（dShares）
// 模型：User → DinariEntity（Dinari 客戶 entity）→ DinariAccount（交易帳戶）→ DinariOrder
// 用戶自管錢包（SCA）：下單走鏈上 EIP155 permit。
// ============================================================

// 每個 Kura 用戶對應一個 Dinari customer Entity
model DinariEntity {
  id        String @id @default(uuid())
  userId    String @unique
  entityId  String @unique // Dinari entity id（uuid）
  kycStatus String @default("not_started") // not_started | PENDING | APPROVED | REJECTED | ...

  // 註：刻意不存 rawKyc。KYC 原始 payload 含 PII（姓名/地址/證件/SSN 等），
  // 後端流程不需要它，只保留 kycStatus 做 gating，降低資料外洩面。
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts DinariAccount[]
}

// Dinari 交易帳戶（連接用戶 SCA）
model DinariAccount {
  id        String @id @default(uuid())
  userId    String
  entityId  String // Dinari entity id
  accountId String @unique // Dinari account id（uuid）

  walletAddress String? // 已連接的用戶錢包（SCA）
  walletChainId String? // CAIP-2，例如 eip155:8453
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity DinariEntity  @relation(fields: [entityId], references: [entityId], onDelete: Cascade)
  orders DinariOrder[]

  @@index([userId])
  @@index([entityId])
  @@index([accountId])
}

// dShare 下單紀錄（EIP155 order request → on-chain order）
model DinariOrder {
  id             String  @id @default(uuid())
  userId         String
  accountId      String // Dinari account id
  orderRequestId String  @unique // EIP155 order request id（主鍵，prepare 後取得）
  orderId        String? // Dinari order id（送出後 on-chain 才有）

  stockId String?
  side    String // BUY | SELL
  type    String // MARKET | LIMIT
  tif     String  @default("DAY") // DAY | GTC | IOC | FOK
  status  String  @default("QUOTED") // QUOTED | PENDING | SUBMITTED | ERROR | CANCELLED | EXPIRED | REJECTED | (order status)

  chainId              String?
  paymentToken         String?
  paymentTokenQuantity String? // 市價買：付款穩定幣數量
  assetTokenQuantity   String? // 市價賣 / 限價：dShare 數量
  limitPrice           String?
  clientOrderId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account DinariAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([orderId])
}

// ==========================================
// 12. Platform Insights（投資人報表 / 平台金流帳本）
// ==========================================

// 經 Kura 管理之統一投資人資料（營收 / waitlist / AUM / Bridge liquidation）
model PlatformRecord {
  id             String   @id @default(uuid())
  category       String   @default("revenue") // revenue | waitlist | active_users
  userId         String?
  source         String   // stripe | bridge_va | bridge_liquidation_in | bridge_liquidation_out | waitlist | debank | ...
  eventType      String
  idempotencyKey String   @unique
  email          String?  // waitlist
  product        String?  // waitlist product slug
  processAmount    Float?
  platformFee    Float?
  netAmount      Float?
  currency       String   @default("usd")
  externalId     String?
  depositId      String?
  scaAddress     String?
  occurredAt     DateTime
  metadata       Json?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, occurredAt])
  @@index([source, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@index([eventType])
  @@index([product])
}
