// ==========================================
// 核心設定 (Configuration)
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. 核心用戶系統 (User & Auth)
// ==========================================
model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  stripeCustomerId           String?   @unique

  // ── SRP 零知識認證 (Phase 2) ──────────────────────────────
  // SRP 不傳遞密碼到伺服器；伺服器只存 verifier（無法反推密碼）
  srpSalt                    String?   // Argon2id salt (hex)，用於 client-side key derivation
  srpVerifier                String?   // SRP verifier (hex)，取代 bcrypt password

  // ── Per-user Data Key (Phase 2) ───────────────────────────
  // Data Key 由後端隨機生成，用 client 推導的 KEK 加密後存放
  // 後端永遠不知道 KEK，因此永遠無法解密 encryptedDataKey
  encryptedDataKey           String?   // AES-GCM(DataKey, KEK)，只有 client 能解密
  kekSalt                    String?   // Argon2id salt for KEK derivation (可與 srpSalt 不同)

  name                       String?
  avatarUrl                  String?
  emailVerified              Boolean   @default(false)
  tier                       String    @default("Basic")
  points                     Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  // 關聯：驗證碼管理
  verificationCodes VerificationCode[]

  // 關聯：Dashboard 模組 (金融帳戶)
  plaidItems       PlaidItem[]
  exchangeAccounts ExchangeAccount[] // 加密貨幣交易所連接

  // 關聯：Plaid 快取模組 (減少 API 調用)
  plaidAccountCache           PlaidAccountCache[]
  plaidTransactionCache       PlaidTransactionCache[]
  plaidInvestmentAccountCache PlaidInvestmentAccountCache[]
  plaidInvestmentCache        PlaidInvestmentCache[]
  plaidSyncLog                PlaidSyncLog?
  plaidRefreshLog             PlaidRefreshLog[]

  // 關聯：API 操作限制 (限制用戶 API 調用頻率)
  apiOperationLogs ApiOperationLog[]

  // 關聯：交易所快取模組 (交易所餘額與資產)
  exchangeBalanceCache ExchangeBalanceCache[]
  exchangeAssetCache   ExchangeAssetCache[]
  exchangeSyncLog      ExchangeSyncLog?

  // 關聯：Asset Performance 模組 (資產績效追蹤)
  assetSnapshots   AssetSnapshot[]
  assetPerformance AssetPerformance?

  // 關聯：通知系統 (Notification System)
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  debankProtocolCache     DeBankProtocolCache[]
  debankTokenCache        DeBankTokenCache[]
  stripeSubscriptions     StripeSubscription[]
}

// ==========================================
// 2. Dashboard 模組 (Banking & Crypto Exchange)
// ==========================================

// 傳統金融綁定 (Plaid 授權紀錄)
model PlaidItem {
  id              String   @id @default(uuid())
  userId          String
  accessToken     String   @unique // Plaid API 的永久存取權杖
  itemId          String   @unique // Plaid 的銀行項目 ID
  transactionsCursor String? // transactions/sync cursor（每個 Plaid item 獨立維護）
  institutionName String // 銀行或券商名稱 (例如: Chase, Robinhood)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2.5 加密貨幣交易所 (Exchange via CCXT)
// ==========================================

// 交易所帳戶綁定 (使用者連結的交易所 API 金鑰)
model ExchangeAccount {
  id                  String  @id @default(uuid())
  userId              String
  exchange            String // 交易所名稱 (例如: "binance", "kraken", "coinbase")
  exchangeDisplayName String // 交易所顯示名稱 (例如: "Binance", "Kraken", "Coinbase")
  apiKey              String // 加密存儲的 API Key (需加密)
  apiSecret           String // 加密存儲的 API Secret (需加密)
  passphrase          String? // 某些交易所需要的密語 (如 OKX)
  isActive            Boolean @default(true)

  // 驗證狀態
  isVerified        Boolean   @default(false) // 是否已驗證連接有效
  lastVerifiedAt    DateTime? // 上次驗證時間
  verificationError String? // 驗證失敗的錯誤信息

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange])
  @@index([userId])
}

// 交易所餘額快取 (按交易所与幣種快取，减少 API 調用)
model ExchangeBalanceCache {
  id                String @id @default(uuid())
  userId            String
  exchangeAccountId String // 所屬的交易所帳戶
  exchange          String // 交易所名稱
  symbol            String // 幣種代碼 (例如: "BTC", "ETH", "USDT")
  free              Float // 可用餘額
  used              Float // 鎖定餘額 (訂單中)
  total             Float // 總餘額 (free + used)

  cacheTtl  Int      @default(300) // 快取過期時間 (秒，預設 5 分鐘)
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchangeAccountId, symbol])
  @@index([userId])
  @@index([userId, exchangeAccountId])
}

// 交易所資產快取 (用户在交易所持有的加密貨幣)
model ExchangeAssetCache {
  id                String @id @default(uuid())
  userId            String
  exchangeAccountId String // 所屬的交易所帳戶
  exchange          String // 交易所名稱
  symbol            String // 幣種代碼 (例如: "BTC", "ETH")
  holdings          Float // 持有數量
  price             Float // 當前價格 (USD)
  value             Float // 資產價值 (USD，= holdings × price)
  percentageOfTotal Float // 佔總資產的百分比

  cacheTtl  Int      @default(300) // 快取過期時間 (秒)
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchangeAccountId, symbol])
  @@index([userId])
  @@index([userId, exchangeAccountId])
}

// 交易所同步狀態 (跟踪每個用戶的交易所最後同步時間)
model ExchangeSyncLog {
  id     String @id @default(uuid())
  userId String @unique

  // 同步狀態
  lastSyncedAt     DateTime? // 上次完整同步時間
  balancesSyncedAt DateTime? // 上次同步餘額
  assetsSyncedAt   DateTime? // 上次同步資產

  // 快取設定 (秒)
  balanceCacheTtl Int @default(300) // 餘額 5 分鐘更新一次
  assetCacheTtl   Int @default(300) // 資產 5 分鐘更新一次

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. Asset Performance 模組 (資產績效追蹤)
// ==========================================

// 資產快照 (記錄某個時間點的資產狀況，用於繪製資產曲線圖)
model AssetSnapshot {
  id       String @id @default(uuid())
  userId   String
  assetId  String // 資產標識 (例如: account-id 或 investment-id)
  name     String // 資產名稱 (例如: "Checking Account", "VTSAX Portfolio")
  type     String // 資產類型 (bank_account, investment, crypto_wallet)
  value    String   // AES-256-GCM 加密的資產價值 (USD)
  currency String @default("USD")

  // 記錄時間戳
  recordedAt DateTime // 記錄時間
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([userId, assetId])
}

// 資產性能總覽 (用戶層級，快取用於快速查詢)
model AssetPerformance {
  id     String @id @default(uuid())
  userId String @unique

  // 總資產
  totalAssets      String    @default("") // AES-256-GCM 加密的總資產價值
  lastRecordedTime DateTime? // 上次記錄時間

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. Plaid 快取模組 (減少 API 調用，降低成本)
// ==========================================

// Plaid 帳戶快取 (銀行帳戶與投資帳戶基本資訊)
model PlaidAccountCache {
  id              String @id @default(uuid())
  userId          String
  plaidItemId     String // 所屬的 Plaid Item
  accountId       String // Plaid 的帳戶 ID
  name            String // 帳戶名稱 (例如: "Chase Checking")
  balance         String   // AES-256-GCM 加密的帳戶餘額
  type            String // 帳戶類型 (checking, saving, credit, investment)
  bucket          String // 帳戶分類 (banking, investment)
  institutionName String // 銀行/券商名稱
  logo            String @default("https://www.google.com/s2/favicons?domain=plaid.com&sz=128")
  apy             String?  // AES-256-GCM 加密的年化報酬率
  mask            String?  // AES-256-GCM 加密的帳號末 4 碼

  cachedAt  DateTime @default(now()) // 快取時間
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
  @@index([userId, plaidItemId])
}

// Plaid 交易快取 (每個月份的交易記錄，按月份分區)
model PlaidTransactionCache {
  id            String @id @default(uuid())
  userId        String
  accountId     String // 所屬帳戶 ID
  transactionId String // Plaid 交易 ID
  merchant      String // 商家名稱
  amount        String // 交易金額
  category      String // 交易分類 (基礎分類)
  type          String // 交易類型 (deposit, credit, transfer)
  date          String // 交易日期 (YYYY-MM-DD)
  month         String // 快取月份 (YYYY-MM)，用於快速查詢

  // ===== 進階交易信息 (Plaid Personal Finance Category 及其他增強) =====
  personalFinanceCategory String? // 個人財務類別 (例: SALARY, SUBSCRIPTION_PAYMENT, TRANSFER_OUT 等)
  isRecurring             Boolean  @default(false) // 是否為定期交易
  recurringFrequency      String?  // 重複頻率 (WEEKLY, MONTHLY, YEARLY, SEMI_MONTHLY, BI_WEEKLY)
  isSubscription          Boolean  @default(false) // 是否為訂閱交易
  
  // 交易增強信息
  enrichedMerchantName    String?  // Plaid 增強的商家名稱 (官方名稱)
  merchantLogo            String?  // 商家 LOGO URL
  merchantCategory        String?  // 商家分類
  
  // Webhook 和同步信息
  lastWebhookUpdate       DateTime? // 上次 webhook 更新時間
  isPending               Boolean  @default(false) // 是否為待處理交易

  cachedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, transactionId])
  @@index([userId])
  @@index([userId, month])
  @@index([userId, accountId])
  @@index([userId, isRecurring]) // 快速查詢定期交易
  @@index([userId, isSubscription]) // 快速查詢訂閱交易
  @@index([userId, personalFinanceCategory]) // 按 PFC 分類查詢
}

// Plaid 投資帳戶快取
model PlaidInvestmentAccountCache {
  id              String @id @default(uuid())
  userId          String
  accountId       String // Plaid 投資帳戶 ID
  name            String // 帳戶名稱
  institutionName String // 券商名稱
  logo            String @default("https://www.google.com/s2/favicons?domain=plaid.com&sz=128")

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
}

// Plaid 投資持倉快取 (股票、加密貨幣等)
model PlaidInvestmentCache {
  id           String @id @default(uuid())
  userId       String
  accountId    String // 所屬投資帳戶 ID
  investmentId String // 投資 ID (accountId-securityId)
  symbol       String // 股票代碼或名稱
  name         String // 資產名稱
  holdings     String // AES-256-GCM 加密的持有數量
  currentPrice String // AES-256-GCM 加密的當前價格
  type         String // 資產類型 (stock, crypto, 等)
  logo         String @default("https://www.google.com/s2/favicons?domain=plaid.com&sz=128")

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, investmentId])
  @@index([userId])
  @@index([userId, accountId])
}

// Plaid 同步狀態 (跟踪每個用戶的最後同步時間，避免過於頻繁的 API 調用)
model PlaidSyncLog {
  id     String @id @default(uuid())
  userId String @unique

  // 同步狀態
  lastSyncedAt         DateTime? // 上次完整同步時間
  accountsSyncedAt     DateTime? // 上次同步帳戶資料
  transactionsSyncedAt DateTime? // 上次同步交易資料 (按月份追蹤)
  investmentsSyncedAt  DateTime? // 上次同步投資資料

  // 同步統計
  totalAccounts     Int @default(0)
  totalTransactions Int @default(0)
  totalInvestments  Int @default(0)

  // 同步間隔設定 (秒)
  accountsCacheTtl     Int @default(3600) // 帳戶資訊 1 小時更新一次
  transactionsCacheTtl Int @default(1800) // 交易資訊 30 分鐘更新一次
  investmentsCacheTtl  Int @default(3600) // 投資資訊 1 小時更新一次

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Plaid 刷新限制日誌 (追蹤用戶每日的強制刷新次數)
model PlaidRefreshLog {
  id           String @id @default(uuid())
  userId       String
  refreshDate  String // YYYY-MM-DD 格式，用於按日期查詢
  refreshCount Int    @default(0) // 該天的刷新次數

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, refreshDate]) // 每個用戶每天只有一條記錄
  @@index([userId])
  @@index([refreshDate])
}

// DeBank 協議快取（按地址保存使用者協議持倉，降低上游 API 壓力）
model DeBankProtocolCache {
  id         String   @id @default(uuid())
  userId     String
  address    String // EVM 錢包地址（0x...）
  protocolId String // DeBank 協議 ID（若缺失則由後端生成穩定 ID）
  chain      String // 鏈名稱（例如：eth、bsc、arb）
  name       String // 協議名稱
  rawData    Json // DeBank 原始協議資料

  cacheTtl  Int      @default(300) // 快取 TTL（秒）
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address, protocolId])
  @@index([userId])
  @@index([userId, address])
  @@index([cachedAt])
}

// DeBank Token 快取（按地址保存使用者 EVM Token 持倉，與 DeFi protocol 分離）
model DeBankTokenCache {
  id        String @id @default(uuid())
  userId    String
  address   String // EVM 錢包地址（0x...）
  chain     String // 鏈名稱（例如：eth、bsc、arb）
  tokenId   String // DeBank token ID（若缺失則由後端生成穩定 ID）
  symbol    String // Token symbol（例如：ETH、USDC）
  name      String // Token 名稱
  rawData   Json // DeBank 原始 token 資料

  cacheTtl  Int      @default(300) // 快取 TTL（秒）
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address, chain, tokenId])
  @@index([userId])
  @@index([userId, address])
  @@index([cachedAt])
}

// API 操作限制日誌 (追蹤用戶每日的 API 操作次數，支持多種操作類型)
model ApiOperationLog {
  id            String @id @default(uuid())
  userId        String
  operationType String // 操作類型: 'exchange_connect', 'exchange_balance', 'plaid_refresh'
  date          String // YYYY-MM-DD 格式，用於按日期查詢
  count         Int    @default(0) // 該天的操作次數

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationType, date]) // 每個用戶每天每種操作類型只有一條記錄
  @@index([userId])
  @@index([date])
  @@index([operationType])
}

// ==========================================
// 5. 統一驗證碼管理
// ==========================================

// 驗證碼表 (統一管理所有驗證場景: 註冊、密碼重置、郵箱修改等)
model VerificationCode {
  id        String   @id @default(uuid())
  userId    String? // 對於未註冊用戶可為 null (例如: 註冊驗證)
  email     String // 驗證碼的目標郵箱
  code      String // 6位驗證碼
  type      String // 驗證碼類型: 'register', 'password-reset', 'email-change'
  metadata  Json? // 額外數據 (例如: 新郵箱、重置令牌等)
  expiresAt DateTime // 過期時間
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([email, type])
  @@index([code])
  @@index([expiresAt])
}

// ==========================================
// 6. 通知系統 (Notification System)
// ==========================================

// 通知記錄表
model Notification {
  id            String    @id @default(uuid())
  userId        String // 接收通知的用戶
  type          String // 通知類型: 'email', 'push', 'in_app'
  category      String // 通知分類: 'price_alert', 'account_activity', 'transaction', 'system_alert', 'security'
  subject       String? // 通知主題 (郵件用)
  title         String // 通知標題
  message       String // 通知內容
  data          Json? // 額外數據
  actionUrl     String? // 動作URL (點擊通知跳轉)
  priority      String    @default("normal") // 優先級: 'low', 'normal', 'high'
  status        String    @default("pending") // 狀態: 'pending', 'sent', 'delivered', 'read', 'failed'
  failureReason String? // 失敗原因
  sentAt        DateTime? // 發送時間
  deliveredAt   DateTime? // 送達時間
  readAt        DateTime? // 閱讀時間
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

// 通知preferences表
model NotificationPreferences {
  id                       String   @id @default(uuid())
  userId                   String   @unique // 一個用戶一條記錄
  enableEmailNotifications Boolean  @default(true) // 啟用郵件通知
  enablePushNotifications  Boolean  @default(true) // 啟用推播通知
  enableInAppNotifications Boolean  @default(true) // 啟用應用內通知
  priceAlertThreshold      Float    @default(5) // 價格變化提醒閾值 (%)
  accountActivityAlerts    Boolean  @default(true) // 帳戶活動提醒
  transactionAlerts        Boolean  @default(true) // 交易提醒
  systemAlerts             Boolean  @default(true) // 系統通知
  securityAlerts           Boolean  @default(true) // 安全警告
  unsubscribeAll           Boolean  @default(false) // 取消訂閱所有通知
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 7. Admin 管理員系統
// ==========================================
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique // 管理員郵箱
  password  String // 加密的密碼
  name      String? // 管理員名稱
  role      String   @default("admin") // 角色 (admin, super_admin 等)
  isActive  Boolean  @default(true) // 是否啟用此帳戶
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

// ==========================================
// 8. Billing 訂閱系統 (Stripe)
// ==========================================
model StripeSubscription {
  id                   String   @id @default(uuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String   @unique
  stripePriceId        String?
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  canceledAt           DateTime?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([stripeCustomerId])
}

model StripeWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  payload       Json?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([type])
}
