// ==========================================
// Core configuration
// ==========================================
generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider            = "prisma-dbml-generator"
  output              = "./dbml"
  outputName          = "schema.dbml"
  projectName         = "BackendServer"
  projectDatabaseType = "PostgreSQL"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. Core user system (User & Auth)
// ==========================================
model User {
  id               String    @id @default(uuid())
  // email from Privy; when no linked email, use {userId}@placeholder.kura-finance.internal
  email            String    @unique
  stripeCustomerId String?   @unique
  referCode        String    @unique
  referredByUserId String?
  referredAt       DateTime?

  // ── Privy auth (replaces SRP) ──────────────────────────────
  // privyUserId: Privy DID (did:privy:...), primary login identity
  // walletAddress: Privy embedded wallet EOA (signing / login binding)
  // scaAddress: ERC-4337 Smart Contract Account (payment settlement)
  privyUserId   String? @unique
  walletAddress String?
  scaAddress    String?

  // ── E2EE KEK derivation salt (now used with Passkey PRF) ──
  // Originally the SRP/password KEK salt; client now derives KEK via
  // Passkey PRF + this salt to wrap encryptedPrivateKey. Backend stores only; never derives.
  kekSalt String?

  // ── E2EE Key Pair (Phase 3 - Zero Access Encryption) ──────
  // Client-generated X25519 keypair:
  //   publicKey used by backend to wrap each sync's SEK
  //   encryptedPrivateKey stored encrypted with KEK; backend can never decrypt
  publicKey           String? // base64(X25519 pubkey, 32 bytes)
  encryptedPrivateKey String? // base64(nonce | XChaCha20-Poly1305(privKey, KEK))
  keyPairAlgorithm    String    @default("x25519-xchacha20")
  keyPairCreatedAt    DateTime?

  name            String?
  avatarUrl       String?
  tier            String   @default("Basic")
  cashbackBalance Float    @default(0)

  // Bridge Fraud Alert: platform-level suspend (blocks delete / re-enroll abuse).
  // Cleared only by admin after the sender withdraws the fraud claim.
  fraudSuspendedAt              DateTime?
  fraudSuspendReason            String?
  fraudSuspendFundsRequestId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations: Dashboard module (financial accounts)
  plaidItems                  PlaidItem[]
  exchangeAccounts            ExchangeAccount[]
  exchangeCaches              ExchangeCache[]

  // Relations: Plaid cache module (reduce API calls)
  plaidAccountCache           PlaidAccountCache[]
  plaidTransactionCache       PlaidTransactionCache[]
  plaidInvestmentAccountCache PlaidInvestmentAccountCache[]
  plaidInvestmentCache        PlaidInvestmentCache[]
  plaidSyncLog                PlaidSyncLog?

  // Relations: API rate limiting (per-user API call frequency)
  apiOperationLogs ApiOperationLog[]

  // Relations: Asset Performance module (per-metric encrypted snapshots)
  assetSnapshots AssetSnapshot[]

  // Relations: Notification system
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  debankCaches            DeBankCache[]
  stripeSubscriptions     StripeSubscription[]
  inviterCashbacks        ReferralCashback[]       @relation("ReferralCashbackInviter")
  referredCashbacks       ReferralCashback[]       @relation("ReferralCashbackReferred")
  cashbackWithdrawals     ReferralCashbackWithdrawal[]

  referredBy    User?  @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers User[] @relation("UserReferrals")

  // Relations: E2EE encrypted payload keys (user may have multiple wrappedSek)
  encryptedPayloadKeys EncryptedPayloadKey[]

  // Relations: Passkey / WebAuthn (E2EE data-layer unlock)
  passkeyCredentials PasskeyCredential[]
  webauthnChallenge  WebAuthnChallenge?

  // Relations: Bridge On/Off Ramp (fiat <-> stablecoin)
  bridgeCustomer         BridgeCustomer?
  bridgeTransfers        BridgeTransfer[]
  bridgeExternalAccounts BridgeExternalAccount[]
  bridgeVirtualAccounts  BridgeVirtualAccount[]
  bridgeVaEvents         BridgeVirtualAccountEvent[]
  bridgeLiquidationAddresses BridgeLiquidationAddress[]
  bridgeFundsRequests    BridgeFundsRequest[]

  // Relations: Dinari Tokenized Stocks (dShares)
  dinariEntity   DinariEntity?
  dinariAccounts DinariAccount[]
  dinariOrders   DinariOrder[]

  // Relations: platform investor reports
  platformRecords PlatformRecord[]

  // Relations: Treasury Safes (org multi-sig, separate from personal SCA)
  activeTreasuryId String?
  treasuries       Treasury[]

  @@index([referredByUserId])
  @@index([scaAddress])
}

// ==========================================
// 5. Passkey / WebAuthn (E2EE data-layer unlock)
// ==========================================

// Registered WebAuthn credential (one per device).
// encryptedDek: 32-byte DEK (hex) wrapped with this passkey's PRF-derived key;
//   returned to client after successful passkey assertion to unlock the data layer.
model PasskeyCredential {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique // base64url credential id
  publicKey    String            // base64 COSE public key
  counter      Int      @default(0)
  transports   String[]          // ['internal','hybrid','usb','nfc','ble']
  deviceType   String?           // 'singleDevice' | 'multiDevice'
  backedUp     Boolean  @default(false)
  encryptedDek String?           // hex(32 bytes): DEK wrapped by passkey
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// In-progress WebAuthn challenge (one per user at a time, with expiry).
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    String   @unique
  challenge String            // base64url challenge
  type      String            // 'registration' | 'authentication'
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ==========================================
// 1.5 E2EE Payload Key (Zero Access Encryption)
// ==========================================
// Each sync generates a Session Encryption Key (SEK) on the backend,
// sealed with the user's publicKey and stored here as wrappedSek.
// All rows in the same sync share one wrappedSek.
// Backend discards the SEK after write and can never unwrap wrappedSek.
//
// Child tables reference this via payloadKeyId (DB FK); reverse relations
// are intentionally omitted here for a cleaner ERD.
model EncryptedPayloadKey {
  id         String   @id @default(uuid())
  userId     String
  // scope examples:
  //   plaid_tx:{plaidItemId}        - Plaid transaction batch
  //   plaid_acct:{plaidItemId}      - Plaid bank account batch
  //   plaid_inv:{plaidItemId}       - Plaid investment batch
  //   exchange_balance:{accountId}  - exchange balance
  //   exchange_asset:{accountId}    - exchange asset
  //   debank_token:{address}        - DeBank token
  //   debank_protocol:{address}     - DeBank protocol
  //   asset_snapshot:{metric}       - asset snapshot (per-metric)
  scope      String
  wrappedSek String // base64(crypto_box_seal(SEK, userPublicKey))
  algorithm  String   @default("x25519-sealedbox+aes-256-gcm")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, createdAt])
}

// ==========================================
// 2. Dashboard module (Banking & Crypto Exchange)
// ==========================================

// Traditional finance link (Plaid authorization record)
model PlaidItem {
  id                 String   @id @default(uuid())
  userId             String
  accessToken        String   @unique // Plaid API permanent access token
  itemId             String   @unique // Plaid bank item ID
  transactionsCursor String? // transactions/sync cursor (per Plaid item)
  institutionName    String // bank or broker name (e.g. Chase, Robinhood)
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // On disconnect, cascade-clear all child caches (onDelete: Cascade set on each cache's plaidItem relation)
  accountCaches           PlaidAccountCache[]
  transactionCaches       PlaidTransactionCache[]
  investmentAccountCaches PlaidInvestmentAccountCache[]
  investmentCaches        PlaidInvestmentCache[]
}

// ==========================================
// 2.5 Crypto exchange (Exchange via CCXT)
// ==========================================

// Exchange account binding (user-linked exchange API keys)
model ExchangeAccount {
  id                  String  @id @default(uuid())
  userId              String
  exchange            String // exchange name (e.g. "binance", "kraken", "coinbase")
  exchangeDisplayName String // display name (e.g. "Binance", "Kraken", "Coinbase")
  apiKey              String // encrypted API Key
  apiSecret           String // encrypted API Secret
  passphrase          String? // passphrase required by some exchanges (e.g. OKX)
  isActive            Boolean @default(true)

  // Verification status
  isVerified        Boolean   @default(false) // whether connection has been verified
  lastVerifiedAt    DateTime? // last verification time
  verificationError String? // error message from failed verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  caches ExchangeCache[]

  @@unique([userId, exchange])
  @@index([userId])
}

// Exchange E2EE cache (balance | asset)
model ExchangeCache {
  id                String @id @default(uuid())
  userId            String
  exchangeAccountId String
  exchange          String
  kind              String // balance | asset
  symbol            String

  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, exchangeAccountId, kind, symbol])
  @@index([userId])
  @@index([userId, exchangeAccountId])
  @@index([userId, exchangeAccountId, kind])
  @@index([payloadKeyId])
}

// ==========================================
// 3. Asset Performance module (asset performance tracking)
// ==========================================

// Asset snapshot (Phase 3 Zero-Access E2EE only).
//
// Each row stores one metric (per-metric snapshot); multiple rows may exist
// for the same metric on the same day. Client takes latest per sub-scoped key
// and sums by base to build daily series.
//
// metric naming:
//   base:       "cashFlow" / "plaidInvestment"
//   sub-scoped: "cryptoSpot:exchange:{accountId}", "cryptoSpot:debank:{address}",
//               "defiProtocol:debank:{address}"
model AssetSnapshot {
  id                String   @id @default(uuid())
  userId            String
  metric            String   // base or sub-scoped metric name
  payloadCiphertext String   // base64(iv | tag | AES-256-GCM(SEK, JSON{value: number}))
  payloadKeyId      String   // wrappedSek pointer

  recordedAt DateTime // recorded at
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([userId, metric, recordedAt])
  @@index([payloadKeyId])
}

// ==========================================
// 4. Plaid cache module (reduce API calls and cost)
// ==========================================

// Plaid account cache (Phase 3 Zero-Access E2EE only).
//
// Backend holds only metadata (plaidItemId / accountId / type / bucket) + payloadCiphertext + payloadKeyId.
// Sensitive fields (name / balance / institutionName / logo / plaidLogo / apy / mask) are fully packed into payloadCiphertext.
model PlaidAccountCache {
  id          String  @id @default(uuid())
  userId      String
  plaidItemId String? // owning Plaid Item (cascade-cleared on disconnect)
  accountId   String // Plaid account ID
  type        String // account type (checking, saving, credit, investment) — used by AssetService for liabilities
  bucket      String // account bucket (banking, investment) — used by AssetService for grouping

  // ── Phase 3 E2EE payload ──
  payloadCiphertext String? // base64(iv | tag | AES-256-GCM(SEK, JSON{name,balance,institutionName,logo,plaidLogo,apy,mask}))
  payloadKeyId      String?

  cachedAt  DateTime @default(now()) // cached at
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([payloadKeyId])
}

// Plaid transaction cache (Phase 3 Zero-Access E2EE only).
//
// Backend holds only metadata (accountId / transactionId / plaidItemId / date / month / isPending /
// isRecurring / isSubscription / lastWebhookUpdate) + payloadCiphertext + payloadKeyId.
// Sensitive fields (amount, merchant, category, type, personalFinanceCategory, recurringFrequency,
// enrichedMerchantName, merchantLogo, merchantCategory, accountName, accountType)
// are fully packed into payloadCiphertext.
model PlaidTransactionCache {
  id     String @id @default(uuid())
  userId String

  // ── metadata (plaintext) ──
  accountId         String // owning account ID
  transactionId     String // Plaid transaction ID (dedup key)
  plaidItemId       String? // owning Plaid Item
  date              String // transaction date (YYYY-MM-DD)
  month             String // cache month (YYYY-MM)
  isPending         Boolean   @default(false)
  isRecurring       Boolean   @default(false)
  isSubscription    Boolean   @default(false)
  lastWebhookUpdate DateTime?

  // ── Phase 3 E2EE payload ──
  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, transactionId])
  @@index([userId])
  @@index([userId, month])
  @@index([userId, accountId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([userId, isRecurring])
  @@index([userId, isSubscription])
  @@index([payloadKeyId])
}

// Plaid investment account cache (Phase 3 Zero-Access E2EE only).
// Backend holds only metadata (accountId) + payloadCiphertext + payloadKeyId.
// Sensitive fields (name, institutionName, logo, plaidLogo) are packed into payloadCiphertext.
model PlaidInvestmentAccountCache {
  id          String  @id @default(uuid())
  userId      String
  plaidItemId String? // owning Plaid Item (cascade-cleared on disconnect)
  accountId   String // Plaid investment account ID

  // ── Phase 3 E2EE payload ──
  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([payloadKeyId])
}

// Plaid investment holdings cache (Phase 3 Zero-Access E2EE only).
// Backend holds only metadata (accountId / investmentId / type) + payloadCiphertext + payloadKeyId.
// Sensitive fields (symbol, name, holdings, currentPrice, change24h, logo) are packed into payloadCiphertext.
model PlaidInvestmentCache {
  id           String  @id @default(uuid())
  userId       String
  plaidItemId  String? // owning Plaid Item (cascade-cleared on disconnect)
  accountId    String // owning investment account ID
  investmentId String // investment ID (accountId-securityId)
  type         String // asset type (stock, crypto, etf...) — used for grouping stats

  // ── Phase 3 E2EE payload (contains symbol, name, holdings, currentPrice, change24h, logo) ──
  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem  PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@unique([userId, investmentId])
  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, plaidItemId])
  @@index([plaidItemId])
  @@index([payloadKeyId])
}

// Plaid sync state (tracks last sync per user to avoid overly frequent API calls)
model PlaidSyncLog {
  id     String @id @default(uuid())
  userId String @unique

  // Sync status
  lastSyncedAt         DateTime? // last full sync time
  accountsSyncedAt     DateTime? // last accounts sync
  transactionsSyncedAt DateTime? // last transactions sync (tracked by month)
  investmentsSyncedAt  DateTime? // last investments sync

  // Sync stats
  totalAccounts     Int @default(0)
  totalTransactions Int @default(0)
  totalInvestments  Int @default(0)

  // Cache TTL settings (seconds)
  accountsCacheTtl     Int @default(3600) // accounts: refresh every 1 hour
  transactionsCacheTtl Int @default(1800) // transactions: refresh every 30 minutes
  investmentsCacheTtl  Int @default(3600) // investments: refresh every 1 hour

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// DeBank E2EE cache (protocol | token)
model DeBankCache {
  id      String @id @default(uuid())
  userId  String
  kind    String // protocol | token
  address String
  chain   String
  entityId String // protocolId or tokenId

  payloadCiphertext String?
  payloadKeyId      String?

  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, address, chain, entityId])
  @@index([userId])
  @@index([userId, address])
  @@index([cachedAt])
  @@index([payloadKeyId])
}

// API operation rate-limit log (tracks daily per-user API ops across operation types)
model ApiOperationLog {
  id            String @id @default(uuid())
  userId        String
  operationType String // operation type: 'exchange_connect', 'exchange_balance', 'plaid_refresh'
  date          String // YYYY-MM-DD, for date-scoped queries
  count         Int    @default(0) // operation count for that day

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationType, date]) // one record per user / operation type / day
  @@index([userId])
  @@index([date])
  @@index([operationType])
}

// ==========================================
// 6. Notification system
// ==========================================

// Notification records
model Notification {
  id            String    @id @default(uuid())
  userId        String // recipient user
  type          String // notification type: 'email', 'push', 'in_app'
  category      String // category: 'price_alert', 'account_activity', 'transaction', 'system_alert', 'security'
  subject       String? // subject (for email)
  title         String // title
  message       String // body
  data          Json? // extra data
  actionUrl     String? // action URL (tap/click destination)
  priority      String    @default("normal") // priority: 'low', 'normal', 'high'
  status        String    @default("pending") // status: 'pending', 'sent', 'delivered', 'read', 'failed'
  failureReason String? // failure reason
  sentAt        DateTime? // sent at
  deliveredAt   DateTime? // delivered at
  readAt        DateTime? // read at
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

// Notification preferences
model NotificationPreferences {
  id                       String   @id @default(uuid())
  userId                   String   @unique // one record per user
  enableEmailNotifications Boolean  @default(true) // enable email notifications
  enablePushNotifications  Boolean  @default(true) // enable push notifications
  enableInAppNotifications Boolean  @default(true) // enable in-app notifications
  priceAlertThreshold      Float    @default(5) // price-change alert threshold (%)
  accountActivityAlerts    Boolean  @default(true) // account activity alerts
  transactionAlerts        Boolean  @default(true) // transaction alerts
  systemAlerts             Boolean  @default(true) // system alerts
  securityAlerts           Boolean  @default(true) // security alerts
  unsubscribeAll           Boolean  @default(false) // unsubscribe from all notifications
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6.5 Waitlist (public landing page form)
// ==========================================

model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String
  product   String   @default("default") // e.g. kura-app | dinari | card
  name      String?
  source    String? // landing | app_store | referral ...
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, product])
  @@index([createdAt])
  @@index([source])
  @@index([product])
}

// ==========================================
// 8. Billing subscription system (Stripe)
// ==========================================
model StripeSubscription {
  id                   String    @id @default(uuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  stripePriceId        String?
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([stripeCustomerId])
}

model StripeWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  payload       Json?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([type])
}

model ReferralCashback {
  id                   String    @id @default(uuid())
  inviterUserId        String
  referredUserId       String
  source               String    @default("stripe") // stripe | bridge_va | dinari | ...
  idempotencyKey       String    @unique
  externalId           String?
  eventType            String?
  stripeInvoiceId      String?   @unique
  stripeChargeId       String?
  stripeSubscriptionId String?
  grossAmount          Float
  cashbackAmount       Float
  currency             String    @default("usd")
  status               String    @default("pending") // pending | available | reversed
  availableAt          DateTime
  settledAt            DateTime?
  reversedAt           DateTime?
  reverseReason        String?
  reversedByEventId    String?
  createdAt            DateTime  @default(now())

  inviter  User @relation("ReferralCashbackInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralCashbackReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([inviterUserId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([status, availableAt])
  @@index([stripeChargeId])
  @@index([source, createdAt])
}

// Referral cashback withdrawal request (manual payout; deducts balance on apply and notifies Support)
model ReferralCashbackWithdrawal {
  id               String    @id @default(uuid())
  userId           String
  amount           Float
  currency         String    @default("usd")
  destinationAddress String
  status           String    @default("pending") // pending | completed | rejected
  completedAt      DateTime?
  rejectedAt       DateTime?
  rejectReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ==========================================
// 9. Bridge On/Off Ramp (fiat <-> stablecoin)
// ==========================================
// Bridge (api.bridge.xyz) provides fiat <-> stablecoin on/off ramp.
// Flow: create a Bridge customer (complete KYC + TOS via hosted KYC link),
// then after KYC approval and required endorsements, create transfers for deposits/withdrawals.

// Bridge customer (one per user; tracks KYC / endorsement status)
model BridgeCustomer {
  id               String  @id @default(uuid())
  userId           String  @unique
  bridgeCustomerId String? @unique // Bridge customer ID (cust_...)
  kycLinkId        String? @unique // Bridge kyc_link ID

  customerType String  @default("individual") // individual | business
  email        String?
  // Note: intentionally do not store fullName / rawCustomer. Both contain PII
  // (legal name, full KYC payload). Backend only needs fullName to forward to
  // Bridge /kyc_links in real time; status is expressed via kycStatus / endorsements.

  kycLink   String? // hosted KYC link
  tosLink   String? // hosted TOS link
  kycStatus String  @default("not_started")
  // not_started | incomplete | awaiting_questionnaire | awaiting_ubo | under_review | approved | rejected | paused | offboarded
  // Note: awaiting_questionnaire / awaiting_ubo are KYB (business) flow only
  tosStatus String  @default("pending") // pending | approved

  endorsements Json? // Bridge endorsements array (base / sepa / spei ...)
  // Full Bridge rejection_reasons payload (includes developer_reason); API returns only customer-visible reason
  rejectionReasons Json?
  customerNamedPayoutAt DateTime? // customer-named fiat payout configured with Bridge

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalAccounts     BridgeExternalAccount[]
  transfers            BridgeTransfer[]
  virtualAccounts      BridgeVirtualAccount[]
  liquidationAddresses BridgeLiquidationAddress[]

  @@index([kycStatus])
}

// Bridge external bank account (off-ramp fiat payout destination)
model BridgeExternalAccount {
  id                      String  @id @default(uuid())
  userId                  String
  bridgeExternalAccountId String  @unique // Bridge external_account ID
  bridgeCustomerId        String? // owning Bridge customer (cust_...)
  bankName                String?
  accountOwnerName        String?
  last4                   String?
  currency                String  @default("usd")
  active                  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer               BridgeCustomer?              @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)
  payoutLiquidationAddresses BridgeLiquidationAddress[]

  @@index([userId])
  @@index([bridgeCustomerId])
}

// Bridge transfer (on-ramp / off-ramp / crypto-to-crypto)
model BridgeTransfer {
  id               String  @id @default(uuid())
  userId           String
  bridgeCustomerId String? // owning Bridge customer (cust_...)
  bridgeTransferId String  @unique // Bridge transfer ID

  direction String // onramp | offramp | crypto
  state     String @default("awaiting_funds")
  // awaiting_funds | in_review | funds_received | payment_submitted | payment_processed | returned | refunded | canceled | error

  amount       String? // amount (decimal string, e.g. "100.25")
  developerFee String? // developer fee (decimal string)

  // ── source (funding source) ──
  sourceRail     String? // ach_push | wire | sepa | spei | ethereum | base | polygon | solana | arbitrum ...
  sourceCurrency String? // usd | eur | mxn | usdc | usdb | eurc ...

  // ── destination (where funds go) ──
  destinationRail        String?
  destinationCurrency    String?
  destinationAddress     String? // on-ramp crypto to_address
  destinationExternalId  String? // off-ramp external_account ID
  destinationTxHash      String?

  // Deposit instructions returned by Bridge for the user (fiat bank details or crypto deposit address)
  depositInstructions Json?

  clientReferenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer BridgeCustomer?  @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, direction])
  @@index([state])
  @@index([bridgeTransferId])
  @@index([bridgeCustomerId])
}

// Bridge Virtual Account (per-user persistent fiat deposit account; primary on-ramp method)
// Deposits to this account auto-convert to stablecoin and send to destination; no per-deposit memo needed.
model BridgeVirtualAccount {
  id                     String  @id @default(uuid())
  userId                 String
  bridgeCustomerId       String? // owning Bridge customer (cust_...)
  bridgeVirtualAccountId String  @unique // Bridge virtual account ID

  status String @default("activated") // activated | deactivated

  // ── source (fiat deposit currency) ──
  sourceCurrency String // usd | eur | mxn ...

  // ── destination (crypto destination after auto-conversion) ──
  destinationRail     String // ethereum | base | polygon | solana ...
  destinationCurrency String // usdc | usdb ...
  destinationAddress  String

  developerFeePercent String? // developer fee percent (base 100, e.g. "1.0" = 1%)

  // Bank deposit instructions from Bridge (persistent; returned directly to client)
  depositInstructions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer BridgeCustomer?             @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)
  events   BridgeVirtualAccountEvent[]

  // One VA per user for each (deposit currency + destination chain + destination currency)
  @@unique([userId, sourceCurrency, destinationRail, destinationCurrency])
  @@index([userId])
  @@index([bridgeVirtualAccountId])
  @@index([bridgeCustomerId])
}

// Virtual Account activity ledger (deposit / payout events from webhooks and history)
model BridgeVirtualAccountEvent {
  id                     String @id @default(uuid())
  userId                 String
  bridgeVirtualAccountId String // owning Bridge virtual account
  bridgeEventId          String @unique // VA event id (dedup)

  type String // funds_received | payment_submitted | payment_processed | refunded | in_review | ...

  amount             String?
  currency           String?
  subtotalAmount     String?
  developerFeeAmount String?
  exchangeFeeAmount  String?
  gasFee             String?
  depositId          String? // shared deposit id across related events
  destinationTxHash  String?
  source             Json? // Bridge event source (payer, payment rail, etc.)

  occurredAt DateTime?
  createdAt  DateTime @default(now())

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  virtualAccount BridgeVirtualAccount @relation(fields: [bridgeVirtualAccountId], references: [bridgeVirtualAccountId], onDelete: Cascade)

  @@index([userId])
  @@index([bridgeVirtualAccountId])
  @@index([depositId])
}

// Bridge Liquidation Address (permanent crypto deposit/payout address)
// direction=in: crypto deposit e.g. Tron USDT → Base USDC
// direction=out: Base USDC → fiat bank payout
model BridgeLiquidationAddress {
  id                         String  @id @default(uuid())
  userId                     String
  bridgeCustomerId           String?
  bridgeLiquidationAddressId String  @unique // Bridge liquidation address ID (la_...)

  direction String // in | out
  state     String @default("active") // active | deactivated

  // ── source (crypto deposit/payout source) ──
  sourceChain    String // tron | base ...
  sourceCurrency String // usdt | usdc ...

  // ── destination (where funds go after auto-conversion) ──
  destinationRail             String // base | wire | pix ...
  destinationCurrency           String // usdc | usd | brl ...
  destinationAddress            String? // in: user's crypto receive address
  bridgeExternalAccountId       String? // out: Bridge external_account ID
  returnAddress                 String? // out: crypto address for failed-refund

  depositAddress  String  // permanent deposit address from Bridge
  blockchainMemo  String? // required memo on chains like Tron

  developerFeePercent String? // custom_developer_fee_percent (base 100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer        BridgeCustomer?        @relation(fields: [bridgeCustomerId], references: [bridgeCustomerId], onDelete: SetNull)
  externalAccount BridgeExternalAccount? @relation(fields: [bridgeExternalAccountId], references: [bridgeExternalAccountId], onDelete: SetNull)

  @@unique([userId, direction, sourceChain, sourceCurrency, destinationRail, destinationCurrency, bridgeExternalAccountId])
  @@index([userId])
  @@index([userId, direction])
  @@index([bridgeLiquidationAddressId])
  @@index([bridgeCustomerId])
  @@index([bridgeExternalAccountId])
}

// Bridge webhook event dedup (event_id is globally unique)
model BridgeWebhookEvent {
  id            String   @id @default(uuid())
  bridgeEventId String   @unique // Bridge event_id
  eventCategory String
  eventType     String
  payload       Json?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([eventType])
}

// Bridge Funds Request (bank recall / fraud recall)
// Source: GET /v0/funds_requests (no webhook; requires poll)
// status: open | return_initiated | returned | failed | ignored
model BridgeFundsRequest {
  id                    String  @id @default(uuid())
  bridgeFundsRequestId  String  @unique
  depositId             String
  bridgeCustomerId      String?
  userId                String?

  fraud    Boolean @default(false)
  amount   String?
  currency String?

  noticeCreatedAt  DateTime?
  depositCreatedAt DateTime?
  raw              Json

  status            String  @default("open")
  returnTransferId  String?
  returnError       String?
  lastSyncedAt      DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([depositId])
  @@index([fraud])
  @@index([status])
  @@index([userId])
  @@index([noticeCreatedAt])
  @@index([depositCreatedAt])
  @@index([lastSyncedAt])
}

// ============================================================
// Dinari Tokenized Stocks (dShares)
// Model: User → DinariEntity (Dinari customer entity) → DinariAccount (trading account) → DinariOrder
// User-managed wallet (SCA): orders use on-chain EIP155 permit.
// ============================================================

// One Dinari customer Entity per Kura user
model DinariEntity {
  id        String @id @default(uuid())
  userId    String @unique
  entityId  String @unique // Dinari entity id (uuid)
  kycStatus String @default("not_started") // not_started | PENDING | APPROVED | REJECTED | ...

  // Note: intentionally do not store rawKyc. Raw KYC payload contains PII
  // (name/address/ID/SSN etc.). Backend only needs kycStatus for gating,
  // reducing the data-exposure surface.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts DinariAccount[]
}

// Dinari trading account (linked to user SCA)
model DinariAccount {
  id        String @id @default(uuid())
  userId    String
  entityId  String // Dinari entity id
  accountId String @unique // Dinari account id (uuid)

  walletAddress String? // linked user wallet (SCA)
  walletChainId String? // CAIP-2, e.g. eip155:8453
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity DinariEntity  @relation(fields: [entityId], references: [entityId], onDelete: Cascade)
  orders DinariOrder[]

  @@index([userId])
  @@index([entityId])
  @@index([accountId])
}

// dShare order record (EIP155 order request → on-chain order)
model DinariOrder {
  id             String  @id @default(uuid())
  userId         String
  accountId      String // Dinari account id
  orderRequestId String  @unique // EIP155 order request id (primary key after prepare)
  orderId        String? // Dinari order id (set after on-chain submit)

  stockId String?
  side    String // BUY | SELL
  type    String // MARKET | LIMIT
  tif     String  @default("DAY") // DAY | GTC | IOC | FOK
  status  String  @default("QUOTED") // QUOTED | PENDING | SUBMITTED | ERROR | CANCELLED | EXPIRED | REJECTED | (order status)

  chainId              String?
  paymentToken         String?
  paymentTokenQuantity String? // market buy: payment stablecoin quantity
  assetTokenQuantity   String? // market sell / limit: dShare quantity
  limitPrice           String?
  clientOrderId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account DinariAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([orderId])
}

// ==========================================
// 12. Platform Insights (investor reports / platform cashflow ledger)
// ==========================================

// Unified investor data managed via Kura (revenue / waitlist / AUM / Bridge liquidation)
model PlatformRecord {
  id             String   @id @default(uuid())
  category       String   @default("revenue") // revenue | waitlist | active_users
  userId         String?
  source         String   // stripe | bridge_va | bridge_liquidation_in | bridge_liquidation_out | waitlist | debank | ...
  eventType      String
  idempotencyKey String   @unique
  email          String?  // waitlist
  product        String?  // waitlist product slug
  processAmount    Float?
  platformFee    Float?
  netAmount      Float?
  currency       String   @default("usd")
  externalId     String?
  depositId      String?
  scaAddress     String?
  occurredAt     DateTime
  metadata       Json?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, occurredAt])
  @@index([source, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@index([eventType])
  @@index([product])
}

// ==========================================
// Treasury Safes (org multi-sig workspace)
// ==========================================
model Treasury {
  id        String   @id
  userId    String
  name      String
  address   String
  source    String // created | bound
  saltNonce String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId])
}
